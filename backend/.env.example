# Copiar a .env para correr local (nunca commitear el .env real).
# En Render, estas mismas claves se cargan en Environment Variables del servicio,
# nunca en el chat ni en el repo.

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_aqui

# Secreto para firmar los tokens de sesion de la plataforma (independiente de Odoo).
# Generar uno propio, ej: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambiar_esto
JWT_EXPIRE_MINUTES=480

# URL base de Odoo (no es secreto -- las credenciales de cada usuario SI
# viajan por request y nunca se guardan, ver /pedidos/{id}/generar-oc)
ODOO_URL=https://margo.odoo.com

# Resend (resend.com) para avisos por correo a proveedores sin integracion
# a Odoo -- se usa API HTTP en vez de SMTP porque Render bloquea el
# puerto SMTP saliente en el plan gratuito. Cuenta gratis, sin tarjeta;
# la API key se genera en resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxx
